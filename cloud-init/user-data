#cloud-config
hostname: {{ hostname }}
users:
  - name: cloud-user
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: false
    plain_text_passwd: 'Word123!'
    ssh_authorized_keys:
      - {{ ssh_key }}
ssh_pwauth: true
package_update: true
packages:
  - htop
  - nginx
runcmd:
  - systemctl enable --now nginx
